# Copy to .env. These two values are safe to expose through /api/config.
# Use the new, dedicated Gary Home project after account authorization.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only: needed to create staff Auth accounts and send invitations.
# Existing company accounts can be assigned without this key.
# Never prefix this variable with NEXT_PUBLIC_ or VITE_.
SUPABASE_SECRET_KEY=
